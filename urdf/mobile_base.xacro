<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_width" value="0.3"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.03"/>
  <xacro:property name="wheel_track" value="0.35"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="wheel_collision" value="$(arg wheel_collision)"/>
  <!-- Tâm hộp nằm trước trục bánh một khoảng axle_offset.
       Gốc base_link đặt TRÊN TRỤC BÁNH (chuẩn robot vi sai) để pose odometry
       đúng là pose của base_footprint. -->
  <xacro:property name="axle_offset" value="${base_length / 4.0}"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${axle_offset} 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${axle_offset} 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="5.0" l="${base_length}" w="${base_width}" h="${base_height}"
                       xyz="${axle_offset} 0 ${base_height / 2.0}" rpy="0 0 0"/>
  </link>

  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <!-- Collision cầu (cấu hình cuối của tuần 4): 1 điểm tiếp xúc ngay dưới tâm bánh.
           wheel_collision:=cylinder khôi phục collision trụ cũ (Leff = 0,38 m, odometry
           quay sai ~8,6%) - chỉ dùng cho thí nghiệm "SLAM với odometry xấu" của tuần 5. -->
      <xacro:if value="${wheel_collision == 'cylinder'}">
        <collision>
          <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${wheel_collision == 'cylinder'}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${wheel_radius}"/>
          </geometry>
        </collision>
      </xacro:unless>
      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_length}"
                              xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- x = 0: trục bánh trùng gốc base_link -->
      <origin xyz="0 ${y_reflect * (wheel_track / 2.0)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.2" r="${caster_radius}" xyz="0 0 0" rpy="0 0 0"/>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${base_length / 3.0 + axle_offset} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

</robot>
